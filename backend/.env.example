# Copy this file to `.env` in the same directory (backend/.env) and fill in whichever
# keys you have. Every one of these is optional - the app runs correctly without any
# of them, each feature just falls back to a simpler mode. See the README for details
# on what each fallback looks like.

# Nugen - our domain-aligned TripRescue Advisor model (hackathon requirement). Get a key at
# https://nugen.in/signup?invite=PILLAIUNIV2026 ; NUGEN_MODEL_ID is written automatically by
# `python -m nugen.align run` once the aligned model is deployed. Takes priority over Gemini.
NUGEN_API_KEY=
NUGEN_MODEL_ID=

# Gemini API - enables LLM-generated plain-English explanations (falls back to rule-based text)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a specific model instead of the gemini-flash-lite-latest alias
# GEMINI_MODEL=gemini-3.8-flash

# Supabase - enables real trip persistence across restarts (falls back to in-memory)
# Get these from your Supabase project: Settings -> API -> Project URL / anon public key
SUPABASE_URL=
SUPABASE_KEY=

# OpenWeatherMap - enables the "Check real forecast" button (falls back to "not configured")
# Free tier: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# AviationStack - enables the "Check real flight status" button (falls back to "not configured")
# Free tier: https://aviationstack.com
AVIATIONSTACK_API_KEY=

# Only needed once you actually deploy the frontend somewhere other than localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173
